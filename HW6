import re

texts = [
    "Alice is 20 years old",
    "Bob is 22 years old",
    "Charlie is 19 years old",
]

for text in texts:
    # Use two capturing groups to extract name and age
    match = re.search(r"(\w+) is (\d+) years old", text)

    if match:
        name = match.group(1)
        age = match.group(2)
        print(f"Name: {name}, Age: {age}")
