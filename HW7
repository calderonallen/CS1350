    with open(os.path.join(project_name, "src", "main.py"), "w") as f:
        f.write("print('Hello World')\n")

    print("\nProject structure created!")

def practice_3_intermediate():
    print("\n" + "=" * 50)
    print("EXERCISE 3.2: File Organizer")
    print("=" * 50)

    import os
    import shutil

    messy_folder = "messy_files"

    if not os.path.exists(messy_folder):
        os.mkdir(messy_folder)

    test_files = [
        "document.txt", "image.jpg", "photo.png",
        "report.pdf", "script.py", "data.csv",
        "music.mp3", "video.mp4", "archive.zip"
    ]

    # Create test files
    for file in test_files:
        path = os.path.join(messy_folder, file)
        with open(path, "w") as f:
            f.write(f"Test file: {file}")

    organized = {
        "documents": [".txt", ".pdf", ".doc"],
        "images": [".jpg", ".png", ".gif"],
        "code": [".py", ".js", ".html"],
        "data": [".csv", ".json", ".xml"],
        "media": [".mp3", ".mp4", ".avi"],
        "archives": [".zip", ".tar", ".rar"]
    }

    # Create category folders
    for folder in organized:
        path = os.path.join(messy_folder, folder)
        if not os.path.exists(path):
            os.mkdir(path)

    # Organize files
    for file in os.listdir(messy_folder):
        file_path = os.path.join(messy_folder, file)

        if os.path.isfile(file_path):
            ext = os.path.splitext(file)[1]

            for folder, extensions in organized.items():
                if ext in extensions:
                    dest = os.path.join(messy_folder, folder, file)
                    shutil.move(file_path, dest)
                    break

    print("Files organized successfully!")
def practice_3_advanced():
    print("\n" + "=" * 50)
    print("EXERCISE 3.3: Game Save System")
    print("=" * 50)

    import pickle
    import os
    import shutil
    from datetime import datetime

    # Game class
    class GameState:
        def __init__(self):
            self.player_name = ""
            self.level = 1
            self.score = 0
            self.inventory = []
            self.position = (0, 0)

        def __str__(self):
            return f"{self.player_name} - Level {self.level}, Score: {self.score}"

    # Create game state
    game = GameState()
    game.player_name = "Hero"
    game.level = 5
    game.score = 1250
    game.inventory = ["Sword", "Shield", "Potion"]
    game.position = (10, 25)

    save_dir = "saves"

    if not os.path.exists(save_dir):
        os.mkdir(save_dir)

    # Save game
    with open(os.path.join(save_dir, "save1.pkl"), "wb") as f:
        pickle.dump(game, f)

    # Load game
    with open(os.path.join(save_dir, "save1.pkl"), "rb") as f:
        loaded_game = pickle.load(f)

    print("Loaded Game:")
    print(loaded_game)
    print(loaded_game.inventory)

    # Save slots
    def save_game(game_state, slot_number):
        filename = f"save{slot_number}.pkl"
        path = os.path.join(save_dir, filename)
        with open(path, "wb") as f:
            pickle.dump(game_state, f)

    save_game(game, 2)

    # List saves
    print("\nSave files:")
    for file in os.listdir(save_dir):
        print(file)

    # Backup system
    def create_backup(source_dir, backup_dir="backups"):
        if not os.path.exists(backup_dir):
            os.mkdir(backup_dir)

        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        backup_path = os.path.join(backup_dir, f"backup_{timestamp}")

        shutil.copytree(source_dir, backup_path)
        print(f"Backup created: {backup_path}")
        return backup_path

    backup_path = create_backup(save_dir)

    # Verify backup
    def verify_backup(source, backup):
        source_files = set(os.listdir(source))
        backup_files = set(os.listdir(backup))
        return source_files == backup_files

    print("Backup verified:", verify_backup(save_dir, backup_path))

    # Cleanup old backups
    def cleanup_old_backups(backup_dir, keep_count=3):
        backups = sorted(
            [os.path.join(backup_dir, d) for d in os.listdir(backup_dir)],
            key=os.path.getmtime,
            reverse=True
        )

        for old in backups[keep_count:]:
            shutil.rmtree(old)
            print(f"Deleted old backup: {old}")

    cleanup_old_backups("backups")
