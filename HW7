def practice_3_beginner():
    print("\n" + "=" * 50)
    print("EXERCISE 3.1: Pickle & Project Setup")
    print("=" * 50)

    import pickle
    import os

    # --- Part A: Pickle ---

    shopping_list = ["Apples", "Bananas", "Milk", "Bread"]

    # Save with pickle
    with open("shopping.pkl", "wb") as f:
        pickle.dump(shopping_list, f)

