# Part B: Broadcasting
print("\n---- Part B ----")

prices = np.array([
    [1.20, 1.50, 1.30, 1.40],  # Apple
    [0.50, 0.60, 0.55, 0.45],  # Banana
    [0.80, 0.90, 0.85, 0.75]   # Orange
])

# 1. 10% discount
discounted = prices * 0.9
print("After 10% discount:\n", discounted)

# 2. Add $0.10 delivery fee to each store
delivery_fee = np.array([0.10, 0.10, 0.10, 0.10])
with_delivery = prices + delivery_fee
print("After delivery fee:\n", with_delivery)

# 3. Apply store tax rates
tax_rates = np.array([0.08, 0.06, 0.07, 0.05])
final_prices = prices * (1 + tax_rates)
print("Final prices with tax:\n", final_prices)

# 4. Normalize by subtracting row mean
row_means = np.mean(prices, axis=1, keepdims=True)
normalized = prices - row_means
print("Normalized prices:\n", normalized)
