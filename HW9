def sum_natural(n):
    if n <= 1:   # Base case
        return n
    return n + sum_natural(n - 1)
def count_digits(n):
    if n < 10:   # Base case (single digit)
        return 1
    return 1 + count_digits(n // 10)
def is_palindrome(s):
    import re
    s = re.sub(r'[^a-zA-Z0-9]', '', s).lower()

    if len(s) <= 1:   # Base case
        return True
    if s[0] != s[-1]:
        return False
    return is_palindrome(s[1:-1])
def power(x, n):
    if n == 0:   # Base case
        return 1
    return x * power(x, n - 1)
