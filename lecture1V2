# Intermediate — Input Validator

def validate_username(username):
    """
    A valid username:
      - no leading/trailing spaces (after stripping)
      - length 3–16
      - letters, digits, underscores only
    """
    cleaned = username.strip()

    if len(cleaned) < 3 or len(cleaned) > 16:
        return False, "Length must be between 3 and 16"

    for char in cleaned:
        if not (char.isalnum() or char == "_"):
            return False, "Invalid character found"

    return True, "Valid"


tests = ["  ab  ", "alice_01", "TOOLONGUSERNAMEXX", "ok!", "bob"]

for t in tests:
    valid, reason = validate_username(t)
    print(f"'{t}' -> {valid} ({reason})")

# Advanced — Data Cleaning Pipeline

def clean_csv_records(raw_lines):
    results = []

    for line in raw_lines:
        fields = line.split(",")

        if len(fields) != 3:
            continue

        name = fields[0].strip().title()
        email = fields[1].strip().lower()
        age_str = fields[2].strip()

        if not age_str.isdigit():
            continue

        age = int(age_str)

        results.append({
            "name": name,
            "email": email,
            "age": age
        })

    return results


raw = [
    "  JANE DOE , Jane@Email.COM , 25 ",
    "  bob smith , BOB@SITE.ORG , thirty ",
    "  CAROL WHITE , carol@test.io , 40 "
]

for record in clean_csv_records(raw):
    print(record)

