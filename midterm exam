import numpy as np


def clamp(arr):
    return np.clip(arr, 0, 255)


def brightness(img, amount):
    return clamp(img + amount)


def contrast(img, factor):
    adjusted = (img - 128) * factor + 128
    return clamp(adjusted)


def threshold(img, cutoff):
    result = np.where(img >= cutoff, 255, 0)
    return result


def crop(img, top, left, height, width):
    return img[top:top+height, left:left+width]


def statistics(img):
    stats = {}

    stats["mean"] = np.mean(img)
    stats["std"] = np.std(img)
    stats["min"] = np.min(img)
    stats["max"] = np.max(img)

    bright_pixels = np.sum(img > 200)
    total_pixels = img.size
    stats["bright_pct"] = (bright_pixels / total_pixels) * 100

    return stats


# Example test image
np.random.seed(42)
img = np.random.randit(0,256, size=(6, 8)).astype(np.uint8)

print("Brightness +50")
print(brightness(img, 50))

print("Threshold 128")
print(threshold(img, 128))

print("Crop")
print(crop(img, 1, 2, 3, 4))

print("Statistics")
print(statistics(img))



