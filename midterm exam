### Problem 2: Tournament Bracket (Sets)
class Team:
    def __init__(self, name, players=None):
        self.name = name
        if players is None:
            self.players = set()
        else:
            self.players = set(players)

    def add_player(self, name):
        self.players.add(name)

    def remove_player(self, name):
        self.players.discard(name)  # discard avoids error if player not present

    def roster_size(self):
        return len(self.players)


def shared_players(team1, team2):
    return team1.players.intersection(team2.players)


def all_players(teams):
    all_set = set()
    for team in teams:
        all_set |= team.players
    return all_set


def find_duplicates(teams):
    player_teams = {}

    for team in teams:
        for player in team.players:
            if player not in player_teams:
                player_teams[player] = []
            player_teams[player].append(team.name)

    duplicates = {}
    for player, team_list in player_teams.items():
        if len(team_list) > 1:
            duplicates[player] = sorted(team_list)

    return duplicates


def eligible_allstars(teams, min_teams):
    player_count = {}

    for team in teams:
        for player in team.players:
            if player not in player_count:
                player_count[player] = set()
            player_count[player].add(team.name)

    result = set()
    for player, team_set in player_count.items():
        if len(team_set) >= min_teams:
            result.add(player)

    return result


# Test cases
alpha = Team("Alpha", {"Alice", "Bob", "Carol"})
beta = Team("Beta", {"Carol", "Dave", "Eve"})
gamma = Team("Gamma", {"Eve", "Frank", "Carol"})

print(f"Alpha roster: {alpha.roster_size()}")  # 3

print(shared_players(alpha, beta))  # {'Carol'}
print(all_players([alpha, beta, gamma]))
# {'Alice', 'Bob', 'Carol', 'Dave', 'Eve', 'Frank'}

dupes = find_duplicates([alpha, beta, gamma])
print(dupes)
# {'Carol': ['Alpha', 'Beta', 'Gamma'], 'Eve': ['Beta', 'Gamma']}

print(eligible_allstars([alpha, beta, gamma], 2))
# {'Carol', 'Eve'}

print(eligible_allstars([alpha, beta, gamma], 3))
# {'Carol'}
